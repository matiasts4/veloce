# Dockerfile for Linux GUI Testing (Tauri v2 + Next.js) with CUDA Support
FROM nvidia/cuda:12.2.2-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PATH="/root/.cargo/bin:${PATH}"

# 1. System Dependencies
RUN apt-get update && apt-get install -y \
    curl \
    wget \
    git \
    cmake \
    python3 \
    python3-pip \
    python3-venv \
    build-essential \
    libssl-dev \
    libgtk-3-dev \
    libayatana-appindicator3-dev \
    librsvg2-dev \
    libwebkit2gtk-4.1-dev \
    alsa-utils \
    libasound2-dev \
    libportaudio2 \
    unzip \
    libxdo-dev \
    && rm -rf /var/lib/apt/lists/*

# 2. Build whisper.cpp with CUDA support
WORKDIR /build-whisper
# Fix for libcuda.so.1 missing during docker build (link against stubs)
ENV LD_LIBRARY_PATH="/usr/local/cuda/lib64/stubs:${LD_LIBRARY_PATH}"
RUN ln -s /usr/local/cuda/lib64/stubs/libcuda.so /usr/local/cuda/lib64/stubs/libcuda.so.1 || true
RUN git clone https://github.com/ggerganov/whisper.cpp.git . && \
    cmake -B build -DGGML_CUDA=1 && \
    cmake --build build --config Release -j$(nproc)

# 3. Install Node.js (LTS)
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - && \
    apt-get install -y nodejs && \
    npm install -g yarn

# 3b. Install Bun
RUN curl -fsSL https://bun.sh/install | bash
ENV BUN_INSTALL="/root/.bun"
ENV PATH="$BUN_INSTALL/bin:$PATH"

# 4. Install Rust
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y

# 5. Setup Working Directory
WORKDIR /app

# 6. Copy Dependencies first (Caching)
COPY package.json package-lock.json ./
COPY src-tauri/tauri.conf.json src-tauri/Cargo.toml ./src-tauri/

# 7. Install Node Deps
RUN npm install --legacy-peer-deps

# 8. Copy Source Code
COPY . .

# 9. Prepare Resources (WhisperCPP)
RUN mkdir -p src-tauri/resources/whispercpp && \
    cp /build-whisper/build/bin/whisper-cli src-tauri/resources/whispercpp/ && \
    cp /build-whisper/build/bin/whisper-server src-tauri/resources/whispercpp/ && \
    cp /build-whisper/build/bin/libwhisper.so src-tauri/resources/whispercpp/

# 10. Build Linux Audio Engine
RUN pip3 install pyinstaller
RUN pyinstaller --clean --noconfirm --onefile --name audio-engine python/audio_engine.py --distpath dist

# 11. Patch tauri.conf.json for Linux (Correct paths for bundled resources)
RUN python3 -c "import json; \
    f = 'src-tauri/tauri.conf.json'; \
    data = json.load(open(f)); \
    data['bundle']['resources'] = [ \
    '../dist/audio-engine', \
    '../python/audio_engine.py', \
    'resources/whispercpp/whisper-cli', \
    'resources/whispercpp/whisper-server', \
    'resources/whispercpp/libwhisper.so' \
    ]; \
    json.dump(data, open(f, 'w'), indent=4)"

# 12. Build the App
RUN npm run build

# 13. Run the App
CMD ["npm", "run", "tauri", "dev"]
