{
    "$schema": "https://schema.tauri.app/v2/config/config.json",
    "productName": "Veloce",
    "version": "0.1.0",
    "identifier": "com.veloce.app",
    "build": {
        "beforeDevCommand": "bun run dev",
        "beforeBuildCommand": "bun run build",
        "devUrl": "http://localhost:3000",
        "frontendDist": "../out"
    },
    "app": {
        "windows": [
            {
                "title": "Veloce",
                "width": 420,
                "height": 520,
                "minWidth": 196,
                "minHeight": 52,
                "decorations": false,
                "transparent": true,
                "shadow": false,
                "resizable": true
            }
        ],
        "security": {
            "csp": null,
            "capabilities": [
                "default"
            ]
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "resources": [
            "../dist/audio-engine.exe",
            "../python/audio_engine.py"
        ],
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.ico",
            "icons/icon.icns"
        ]
    }
}