{
    "$schema": "https://schema.tauri.app/v2/config/config.json",
    "productName": "Veloce",
    "version": "0.1.0",
    "identifier": "com.veloce.app",
    "build": {
        "beforeDevCommand": "npm run dev",
        "beforeBuildCommand": "npm run build",
        "devUrl": "http://localhost:3000",
        "frontendDist": "../out"
    },
    "app": {
        "windows": [
            {
                "label": "main",
                "title": "Veloce",
                "width": 420,
                "height": 520,
                "minWidth": 120,
                "minHeight": 40,
                "decorations": false,
                "transparent": true,
                "shadow": false,
                "resizable": true,
                "alwaysOnTop": true
            }
        ],
        "security": {
            "csp": null,
            "capabilities": [
                "default"
            ]
        }
    },
    "bundle": {
        "active": true,
        "targets": [
            "deb"
        ],
        "linux": {
            "deb": {
                "depends": [
                    "python3-venv",
                    "libportaudio2",
                    "libayatana-appindicator3-1",
                    "libappindicator3-1"
                ]
            }
        },
        "resources": [
            "../python/audio_engine.py",
            "resources/python-3.11.9-embed-amd64.zip",
            "resources/requirements.txt",
            "resources/get-pip.py",
            "resources/whispercpp"
        ],
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.ico",
            "icons/icon.icns"
        ]
    }
}